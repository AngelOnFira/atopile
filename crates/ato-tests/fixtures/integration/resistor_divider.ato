module Resistor:
    pin 1
    pin 2
    resistance: ohm

module VoltageDivider:
    pin input
    pin output
    pin gnd

    r1 = new Resistor
    r2 = new Resistor

    input ~ r1.1
    r1.2 ~ output
    output ~ r2.1
    r2.2 ~ gnd

    r1.resistance = 10kohm +/- 5%
    r2.resistance = 10kohm +/- 5%
