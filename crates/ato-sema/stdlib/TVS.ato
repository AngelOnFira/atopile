# TVS module - transient voltage suppressor
# Standard library module for ESD/surge protection

import Electrical

module TVS:
    # Terminals
    anode = new Electrical
    cathode = new Electrical

    # Electrical parameters
    reverse_breakdown_voltage: V
    reverse_working_voltage: V
    max_current: A
    clamping_voltage: V
    forward_voltage: V
    reverse_leakage_current: A

    # Physical parameters
    package: dimensionless

    # Traits
    trait can_bridge_by_name<input_name="anode", output_name="cathode">
    trait has_designator_prefix::prefix<value="D">
