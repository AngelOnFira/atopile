# Ferrite module - ferrite bead for EMI suppression
# Standard library module for ferrite beads

import Electrical

module Ferrite:
    # Primary terminals (array form for bridging)
    unnamed = new Electrical[2]
    # Alternative pin names for compatibility
    p1 = new Electrical
    p2 = new Electrical

    # Electrical parameters
    impedance_at_100mhz: ohm
    max_current: A
    dc_resistance: ohm

    # Physical parameters
    package: dimensionless

    # Traits
    trait can_bridge
    trait has_designator_prefix::prefix<value="FB">
