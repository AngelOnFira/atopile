# LED module - light emitting diode
# Standard library module for LEDs

import Electrical

module LED:
    # Terminals (same as diode)
    anode = new Electrical
    cathode = new Electrical

    # Electrical parameters
    forward_voltage: V
    current: A
    max_current: A

    # Optical parameters
    brightness: cd
    max_brightness: cd
    wavelength: nm

    # Physical parameters
    package: dimensionless

    # Traits
    trait can_bridge_by_name<input_name="anode", output_name="cathode">
    trait has_designator_prefix::prefix<value="D">
