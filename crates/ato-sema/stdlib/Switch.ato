# Switch module - generic electrical switch
# Standard library module for switches

import Electrical

module Switch:
    # Primary terminals (array form for bridging)
    unnamed = new Electrical[2]
    # Alternative pin names for compatibility
    p1 = new Electrical
    p2 = new Electrical

    # Physical parameters
    package: dimensionless

    # Traits
    trait can_bridge
    trait has_designator_prefix::prefix<value="S">
