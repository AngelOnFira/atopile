# Fuse module - overcurrent protection
# Standard library module for fuses and PTCs

import Electrical

module Fuse:
    # Primary terminals (array form for bridging)
    unnamed = new Electrical[2]
    # Alternative pin names for compatibility
    p1 = new Electrical
    p2 = new Electrical

    # Electrical parameters
    trip_current: A
    hold_current: A
    max_voltage: V
    resistance: ohm

    # Physical parameters
    package: dimensionless

    # Traits
    trait can_bridge
    trait has_designator_prefix::prefix<value="F">
