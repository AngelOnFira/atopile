# Resistor module - two-terminal resistor
# Standard library module for resistor components

import Electrical

module Resistor:
    # Primary terminals (array form for bridging)
    unnamed = new Electrical[2]
    # Alternative pin names for compatibility
    p1 = new Electrical
    p2 = new Electrical

    # Electrical parameters
    resistance: ohm
    max_power: W
    max_voltage: V

    # Physical parameters
    package: dimensionless

    # Traits
    trait can_bridge
    trait has_designator_prefix::prefix<value="R">
